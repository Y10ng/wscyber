# 复制为 .env 后填写；仅加载本项目受信任的配置。不要提交真实凭据。
WSCYBER_DB_PASSWORD=replace_with_random_hex
WSCYBER_DB_PORT=15432
WSCYBER_DATABASE_URL=postgres://wscyber:replace_with_random_hex@127.0.0.1:15432/wscyber?sslmode=disable
WSCYBER_AUTH_TOKEN=replace_with_at_least_32_random_characters
WSCYBER_LISTEN=127.0.0.1:8790
WSCYBER_WEB_DIR=web/dist-react
WSCYBER_SANDBOX_IMAGE=wscyber/runtime:local
WSCYBER_SANDBOX_RUNTIME=runc
# 默认允许命令容器联网；直连流量尚不经过 HTTP 风险分流。离线分析可显式选 none。
WSCYBER_SANDBOX_NETWORK=bridge
WSCYBER_ALLOW_LOOPBACK=false
WSCYBER_MAX_PARALLEL=2
WSCYBER_MAX_STEPS=12
WSCYBER_MAX_OUTPUT_BYTES=65536
WSCYBER_MODEL_TIMEOUT=120s
WSCYBER_ACTION_TIMEOUT=30s
# 未配置仍可人工研究、提出动作及审批；不要从其他应用隐式导入密钥。
WSCYBER_MODEL_BASE_URL=
WSCYBER_MODEL_API_KEY=
WSCYBER_MODEL=
# 管理API的AES-256主密钥：32随机字节的标准base64；与数据库分别备份，不自动生成。
# 留空禁用配置管理，不影响既有显式环境模型。切勿复用访问令牌或供应商凭据。
WSCYBER_MODEL_ENCRYPTION_KEY=
